  "narration": [
    {
      "start": 0.0,
      "end": 12.0,
      "text": "Meet the 2025 AVATR 11, a luxury coupe SUV with a distinctive disc-wing front and flowing roofline. Choose battery-electric or range-extended power."
    },
    {
      "start": 12.0,
      "end": 32.0,
      "text": "Battery-electric versions offer up to 815 kilometres of CLTC range, an 800-volt architecture, and up to 240 kilowatts of DC charging. Performance varies by version and conditions."
    },
    {
      "start": 32.0,
      "end": 48.0,
      "text": "The range-extended version offers 225 kilometres of electric CLTC range, and up to 1,065 kilometres combined\u2014another option for buyers planning longer journeys."
    },
    {
      "start": 48.0,
      "end": 64.0,
      "text": "A five-seat digital cabin combines technology and comfort. Selected versions offer seat heating, ventilation and massage, with zero-gravity seating and premium audio depending on configuration."
    },
    {
      "start": 64.0,
      "end": 78.0,
      "text": "Huawei cockpit technology and driver assistance are available on selected versions. Availability depends on trim and destination market. UNILAND supports configuration checks, export documentation and shipping."
    },
    {
      "start": 78.0,
      "end": 90.0,
      "text": "Importers, dealers, fleet buyers and distributors: contact UNILAND MOTORS for factory-new AVATR 11 wholesale pricing and a configuration matched to your market."
    }
  ]
